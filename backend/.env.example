# --- Required ---
MONGO_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/agriconnect?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
NODE_ENV=production

# Frontend origin(s) allowed by CORS + Socket.IO (comma-separated, no trailing slash)
CLIENT_URL=https://your-app.vercel.app

# Public URL of this backend (used for payment redirects)
BACKEND_URL=https://your-api.onrender.com

# --- Optional (PhonePe; defaults to public sandbox test credentials) ---
# PHONEPE_MERCHANT_ID=
# PHONEPE_MERCHANT_KEY=
# PHONEPE_BASE_URL=https://api.phonepe.com/apis/hermes   # production

# PORT is set automatically by Render / Railway
